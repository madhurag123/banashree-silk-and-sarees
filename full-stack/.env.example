# Copy to .dev.vars for local Cloudflare development. Never commit .dev.vars.
# Set these as runtime environment values/secrets on the hosting platform.
APP_URL=http://localhost:5173
# Generate once with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# First-admin setup at /admin; remove this secret after creating your administrator.
ADMIN_SETUP_TOKEN=
# Leave empty for honest demo checkout. Use only matching test/live key pairs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional transactional email via Resend HTTP API; verify your sender domain.
RESEND_API_KEY=
EMAIL_FROM=
